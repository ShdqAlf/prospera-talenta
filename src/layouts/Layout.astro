---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: Record<string, any>;
}

const {
  title,
  description = 'PT Prospera Talenta - Agensi pengadaan dan pengelolaan tenaga penjualan (sales force) B2B skala nasional. Penyedia 38.000+ talenta SPG/SPB, canvassing lapangan, akuisisi user, dan digital growth.',
  canonical,
  schema,
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = 'https://prosperatalenta.co.id';
const canonicalUrl = canonical || new URL(currentPath, siteUrl).toString();

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'PT Prospera Talenta',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: description,
  telephone: '+6281398079090',
  email: 'jasasalesprospera@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Buana Subang Kencana, Blk. D No.29, Karanganyar',
    addressLocality: 'Subang',
    addressRegion: 'Jawa Barat',
    postalCode: '41211',
    addressCountry: 'ID',
  },
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | PT Prospera Talenta</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | PT Prospera Talenta`} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={`${title} | PT Prospera Talenta`} />
    <meta property="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="bg-[#FAF8F5] text-[#1C1917] antialiased">
    <!-- Utility Bar -->
    <div class="bg-[#1C1917] text-[#D6D0C7] text-xs py-2 px-4 border-b border-[#2C2825]">
      <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="text-[#FAF8F5] font-medium">PT Prospera Talenta</span>
          <span class="text-[#57534E]">|</span>
          <span class="text-[#A8A29E]">Mitra Pengadaan Sales Force & Talenta B2B</span>
        </div>
        <div class="flex items-center gap-4 text-[#A8A29E]">
          <a href="mailto:jasasalesprospera@gmail.com" class="hover:text-[#FAF8F5] transition">jasasalesprospera@gmail.com</a>
          <span>•</span>
          <a href="https://wa.me/6281398079090" target="_blank" rel="noopener" class="text-[#FAF8F5] hover:text-[#E86144] transition">WA: 0813-9807-9090</a>
        </div>
      </div>
    </div>

    <!-- Main Navigation -->
    <header class="sticky top-0 z-40 bg-[#FAF8F5]/95 backdrop-blur-sm border-b border-[#E7E2D9]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-18 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded bg-[#C8371B] text-[#FAF8F5] font-bold text-sm flex items-center justify-center tracking-tight">
            PT
          </div>
          <div class="leading-tight">
            <span class="text-base font-bold tracking-tight text-[#1C1917] block">PROSPERA TALENTA</span>
            <span class="text-[10px] uppercase tracking-wider text-[#78716C] block">Corporate Sales Force</span>
          </div>
        </a>

        <!-- Desktop Menu -->
        <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-[#44403C]">
          <a href="/" class={`hover:text-[#C8371B] transition ${currentPath === '/' ? 'text-[#C8371B] font-semibold' : ''}`}>Beranda</a>
          <a href="/layanan" class={`hover:text-[#C8371B] transition ${currentPath.startsWith('/layanan') ? 'text-[#C8371B] font-semibold' : ''}`}>Layanan</a>
          <a href="/layanan/spg-spb-event" class="hover:text-[#C8371B] transition">SPG/SPB</a>
          <a href="/layanan/direct-sales-canvassing" class="hover:text-[#C8371B] transition">Canvassing</a>
          <a href="/artikel" class={`hover:text-[#C8371B] transition ${currentPath.startsWith('/artikel') ? 'text-[#C8371B] font-semibold' : ''}`}>Artikel</a>
          <a href="/tentang" class={`hover:text-[#C8371B] transition ${currentPath === '/tentang' ? 'text-[#C8371B] font-semibold' : ''}`}>Tentang</a>
          <a href="/kontak" class={`hover:text-[#C8371B] transition ${currentPath === '/kontak' ? 'text-[#C8371B] font-semibold' : ''}`}>Kontak</a>
        </nav>

        <!-- Right Action Button -->
        <div class="hidden sm:flex items-center">
          <a
            href="https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20saya%20ingin%20konsultasi%20kebutuhan%20sales%20force%20perusahaan."
            target="_blank"
            rel="noopener"
            class="bg-[#C8371B] hover:bg-[#A82B13] text-[#FAF8F5] text-xs font-semibold px-4 py-2.5 rounded transition"
          >
            Konsultasi Proyek
          </a>
        </div>

        <!-- Mobile Menu Toggle -->
        <button id="mobile-toggle" type="button" aria-label="Menu" class="md:hidden p-2 text-[#44403C]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown -->
      <div id="mobile-dropdown" class="hidden md:hidden border-t border-[#E7E2D9] bg-[#FAF8F5] px-4 py-4 space-y-2 text-sm">
        <a href="/" class="block py-1.5 font-medium text-[#1C1917]">Beranda</a>
        <a href="/layanan" class="block py-1.5 font-medium text-[#1C1917]">Katalog Layanan</a>
        <a href="/layanan/spg-spb-event" class="block py-1 text-xs text-[#57534E] pl-2">↳ Jasa SPG/SPB</a>
        <a href="/layanan/direct-sales-canvassing" class="block py-1 text-xs text-[#57534E] pl-2">↳ Direct Sales & Canvassing</a>
        <a href="/layanan/clipper-short-video" class="block py-1 text-xs text-[#57534E] pl-2">↳ Clipper Video</a>
        <a href="/artikel" class="block py-1.5 font-medium text-[#1C1917]">Artikel & Wawasan</a>
        <a href="/tentang" class="block py-1.5 font-medium text-[#1C1917]">Tentang Kami</a>
        <a href="/kontak" class="block py-1.5 font-medium text-[#1C1917]">Kontak</a>
        <div class="pt-2">
          <a
            href="https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20saya%20ingin%20konsultasi."
            target="_blank"
            rel="noopener"
            class="block text-center bg-[#C8371B] text-[#FAF8F5] py-2 rounded text-xs font-semibold"
          >
            Hubungi WhatsApp
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Discreet WhatsApp Float -->
    <aside class="fixed bottom-5 right-5 z-50">
      <a
        href="https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20saya%20ingin%20tanya%20layanan%20sales."
        target="_blank"
        rel="noopener"
        class="flex items-center gap-2 bg-[#1C1917] hover:bg-[#C8371B] text-[#FAF8F5] px-3.5 py-2.5 rounded shadow text-xs font-medium transition"
        aria-label="Kontak WhatsApp"
      >
        <span class="w-2 h-2 rounded-full bg-[#E86144]"></span>
        <span>WhatsApp Konsultasi</span>
      </a>
    </aside>

    <!-- Footer -->
    <footer class="bg-[#1C1917] text-[#A8A29E] pt-14 pb-10 border-t border-[#292524] text-xs">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-[#292524]">
          <div class="md:col-span-1">
            <span class="text-sm font-bold text-[#FAF8F5] tracking-tight block mb-2">PT PROSPERA TALENTA</span>
            <p class="leading-relaxed text-[#78716C] mb-4">
              Penyedia dan pengelola tenaga penjualan lapangan serta talenta digital B2B terstruktur di Indonesia.
            </p>
            <p class="text-[#78716C]">prosperatalenta.co.id</p>
          </div>

          <div>
            <p class="font-semibold text-[#FAF8F5] uppercase tracking-wider mb-3">Layanan Lapangan</p>
            <ul class="space-y-2">
              <li><a href="/layanan/spg-spb-event" class="hover:text-[#FAF8F5] transition">SPG & SPB Event</a></li>
              <li><a href="/layanan/direct-sales-canvassing" class="hover:text-[#FAF8F5] transition">Direct Sales & Canvassing</a></li>
              <li><a href="/layanan/sales-aplikasi-fintech" class="hover:text-[#FAF8F5] transition">Sales Aplikasi Mobile</a></li>
              <li><a href="/layanan/mystery-shopper-audit" class="hover:text-[#FAF8F5] transition">Mystery Shopper</a></li>
              <li><a href="/layanan/crew-event-organizer" class="hover:text-[#FAF8F5] transition">Crew Event & Usher</a></li>
            </ul>
          </div>

          <div>
            <p class="font-semibold text-[#FAF8F5] uppercase tracking-wider mb-3">Layanan Digital</p>
            <ul class="space-y-2">
              <li><a href="/layanan/clipper-short-video" class="hover:text-[#FAF8F5] transition">Clipper Video TikTok/Reels</a></li>
              <li><a href="/layanan/buzzer-dan-kol-activation" class="hover:text-[#FAF8F5] transition">Buzzer & Micro KOL</a></li>
              <li><a href="/layanan/rating-review-google-marketplace" class="hover:text-[#FAF8F5] transition">Rating & Review Organik</a></li>
              <li><a href="/layanan/host-live-streaming" class="hover:text-[#FAF8F5] transition">Host Live Streaming</a></li>
              <li><a href="/layanan/aktivasi-komunitas-crowd" class="hover:text-[#FAF8F5] transition">Aktivasi Komunitas</a></li>
            </ul>
          </div>

          <div>
            <p class="font-semibold text-[#FAF8F5] uppercase tracking-wider mb-3">Kantor & Kontak</p>
            <div class="space-y-2 text-[#78716C]">
              <p>Buana Subang Kencana, Blk. D No.29, Karanganyar, Subang, Jawa Barat 41211</p>
              <p><strong class="text-[#A8A29E]">WhatsApp:</strong> 0813-9807-9090</p>
              <p><strong class="text-[#A8A29E]">Email:</strong> jasasalesprospera@gmail.com</p>
            </div>
          </div>
        </div>

        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-[#78716C] gap-3">
          <p>© {new Date().getFullYear()} PT Prospera Talenta. Hak Cipta Dilindungi.</p>
          <div class="flex items-center gap-4">
            <a href="/tentang" class="hover:text-[#A8A29E]">Tentang</a>
            <a href="/layanan" class="hover:text-[#A8A29E]">Layanan</a>
            <a href="/artikel" class="hover:text-[#A8A29E]">Artikel</a>
            <a href="/kontak" class="hover:text-[#A8A29E]">Kontak</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-toggle');
      const menu = document.getElementById('mobile-dropdown');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
