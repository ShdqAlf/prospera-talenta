---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = 'PT Prospera Talenta - Agensi pengadaan dan pengelolaan jasa sales B2B skala nasional. Penyedia tim direct sales, SPG usher, KOL visit, mystery shopper, dan riset pasar.',
  canonical,
  image = 'https://prosperatalenta.co.id/og-image.png',
  schema,
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = 'https://prosperatalenta.co.id';
const canonicalUrl = canonical || new URL(currentPath, siteUrl).toString();

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'PT Prospera Talenta',
  alternateName: 'Jasa Sales PT Prospera Talenta',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  image: `${siteUrl}/favicon.svg`,
  description: description,
  telephone: '+6281398079090',
  email: 'jasasalesprospera@gmail.com',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Buana Subang Kencana, Blk. D No.29, Karanganyar',
    addressLocality: 'Subang',
    addressRegion: 'Jawa Barat',
    postalCode: '41211',
    addressCountry: 'ID',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -6.5684,
    longitude: 107.7584,
  },
  areaServed: {
    '@type': 'Country',
    name: 'Indonesia',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:30',
      closes: '17:30',
    },
  ],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | PT Prospera Talenta</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | PT Prospera Talenta`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={`${title} | PT Prospera Talenta`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {schema && (
      Array.isArray(schema)
        ? schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)
        : <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body class="bg-[#FAF8F5] text-[#1C1917] antialiased">
    <!-- Utility Bar -->
    <div class="bg-[#1C1917] text-[#D6D0C7] text-xs py-2 px-4 border-b border-[#2C2825]">
      <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="text-[#FAF8F5] font-medium">PT Prospera Talenta</span>
          <span class="text-[#57534E]">|</span>
          <span class="text-[#A8A29E]">Mitra Pengadaan Jasa Sales & Talenta B2B</span>
        </div>
        <div class="flex items-center gap-4 text-[#A8A29E]">
          <a href="mailto:jasasalesprospera@gmail.com" class="hover:text-[#FAF8F5] transition">jasasalesprospera@gmail.com</a>
          <span>•</span>
          <a href="https://wa.me/6281398079090" target="_blank" rel="noopener" class="text-[#FAF8F5] hover:text-[#E86144] transition">WA: 0813-9807-9090</a>
        </div>
      </div>
    </div>

    <!-- Main Navigation -->
    <header class="sticky top-0 z-40 bg-[#FAF8F5]/95 backdrop-blur-sm border-b border-[#E7E2D9]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-18 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded bg-[#C8371B] text-[#FAF8F5] font-bold text-sm flex items-center justify-center tracking-tight">
            PT
          </div>
          <div class="leading-tight">
            <span class="text-base font-bold tracking-tight text-[#1C1917] block">PROSPERA TALENTA</span>
            <span class="text-[10px] uppercase tracking-wider text-[#78716C] block">Corporate Sales Force</span>
          </div>
        </a>

        <!-- Desktop Menu -->
        <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-[#44403C]">
          <a href="/" class={`hover:text-[#C8371B] transition ${currentPath === '/' ? 'text-[#C8371B] font-semibold' : ''}`}>Beranda</a>

          <!-- Dropdown Layanan -->
          <div class="relative group">
            <a
              href="/layanan"
              class={`flex items-center gap-1.5 hover:text-[#C8371B] transition py-2 ${currentPath.startsWith('/layanan') ? 'text-[#C8371B] font-semibold' : ''}`}
            >
              <span>Layanan</span>
              <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 text-[#78716C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </a>

            <div class="absolute left-0 top-full pt-1.5 w-64 hidden group-hover:block group-focus-within:block z-50">
              <div class="bg-white border border-[#E7E2D9] rounded-lg shadow-xl py-2 overflow-hidden">
                <a href="/layanan/jasa-direct-sales" class="block px-4 py-2 hover:bg-[#FAF8F5] text-xs font-medium text-[#1C1917] hover:text-[#C8371B] transition">
                  Jasa Direct Sales
                </a>
                <a href="/layanan/jasa-kol-visit" class="block px-4 py-2 hover:bg-[#FAF8F5] text-xs font-medium text-[#1C1917] hover:text-[#C8371B] transition">
                  Jasa KOL Visit
                </a>
                <a href="/layanan/jasa-riset-pasar" class="block px-4 py-2 hover:bg-[#FAF8F5] text-xs font-medium text-[#1C1917] hover:text-[#C8371B] transition">
                  Jasa Riset Pasar
                </a>
                <a href="/layanan/jasa-mystery-shopper" class="block px-4 py-2 hover:bg-[#FAF8F5] text-xs font-medium text-[#1C1917] hover:text-[#C8371B] transition">
                  Jasa Mystery Shopper
                </a>
                <a href="/layanan/jasa-spg-usher" class="block px-4 py-2 hover:bg-[#FAF8F5] text-xs font-medium text-[#1C1917] hover:text-[#C8371B] transition">
                  Jasa SPG Usher
                </a>
                <a href="/layanan/jasa-sebar-kuesioner" class="block px-4 py-2 hover:bg-[#FAF8F5] text-xs font-medium text-[#1C1917] hover:text-[#C8371B] transition">
                  Jasa Sebar Kuesioner
                </a>
                <div class="border-t border-[#E7E2D9] my-1.5"></div>
                <a href="/layanan" class="block px-4 py-1.5 text-[11px] font-semibold text-[#78716C] hover:text-[#C8371B] transition">
                  Lihat Semua Layanan &rarr;
                </a>
              </div>
            </div>
          </div>

          <a href="/artikel" class={`hover:text-[#C8371B] transition ${currentPath.startsWith('/artikel') ? 'text-[#C8371B] font-semibold' : ''}`}>Artikel</a>
          <a href="/tentang" class={`hover:text-[#C8371B] transition ${currentPath === '/tentang' ? 'text-[#C8371B] font-semibold' : ''}`}>Tentang</a>
          <a href="/kontak" class={`hover:text-[#C8371B] transition ${currentPath === '/kontak' ? 'text-[#C8371B] font-semibold' : ''}`}>Kontak</a>
        </nav>

        <!-- Right Action Button -->
        <div class="hidden sm:flex items-center">
          <a
            href="https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20saya%20ingin%20konsultasi%20kebutuhan%20jasa%20sales%20perusahaan."
            target="_blank"
            rel="noopener"
            class="bg-[#C8371B] hover:bg-[#A82B13] text-[#FAF8F5] text-xs font-semibold px-4 py-2.5 rounded transition"
          >
            Konsultasi Proyek
          </a>
        </div>

        <!-- Mobile Menu Toggle -->
        <button id="mobile-toggle" type="button" aria-label="Menu" class="md:hidden p-2 text-[#44403C]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown -->
      <div id="mobile-dropdown" class="hidden md:hidden border-t border-[#E7E2D9] bg-[#FAF8F5] px-4 py-4 space-y-3 text-sm">
        <a href="/" class="block py-1 font-medium text-[#1C1917]">Beranda</a>

        <div class="space-y-1.5 pt-1">
          <div class="font-semibold text-xs uppercase tracking-wider text-[#78716C]">Layanan Kami</div>
          <div class="pl-2 border-l-2 border-[#E7E2D9] space-y-2 text-xs">
            <a href="/layanan/jasa-direct-sales" class="block text-[#1C1917] hover:text-[#C8371B]">Jasa Direct Sales</a>
            <a href="/layanan/jasa-kol-visit" class="block text-[#1C1917] hover:text-[#C8371B]">Jasa KOL Visit</a>
            <a href="/layanan/jasa-riset-pasar" class="block text-[#1C1917] hover:text-[#C8371B]">Jasa Riset Pasar</a>
            <a href="/layanan/jasa-mystery-shopper" class="block text-[#1C1917] hover:text-[#C8371B]">Jasa Mystery Shopper</a>
            <a href="/layanan/jasa-spg-usher" class="block text-[#1C1917] hover:text-[#C8371B]">Jasa SPG Usher</a>
            <a href="/layanan/jasa-sebar-kuesioner" class="block text-[#1C1917] hover:text-[#C8371B]">Jasa Sebar Kuesioner</a>
            <a href="/layanan" class="block font-semibold text-[#C8371B] pt-1">Semua Katalog Layanan &rarr;</a>
          </div>
        </div>

        <a href="/artikel" class="block py-1 font-medium text-[#1C1917]">Artikel & Wawasan</a>
        <a href="/tentang" class="block py-1 font-medium text-[#1C1917]">Tentang Kami</a>
        <a href="/kontak" class="block py-1 font-medium text-[#1C1917]">Kontak</a>
        <div class="pt-2">
          <a
            href="https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20saya%20ingin%20konsultasi%20jasa%20sales."
            target="_blank"
            rel="noopener"
            class="block text-center bg-[#C8371B] text-[#FAF8F5] py-2 rounded text-xs font-semibold"
          >
            Hubungi WhatsApp
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Discreet WhatsApp Float -->
    <aside class="fixed bottom-5 right-5 z-50">
      <a
        href="https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20saya%20ingin%20tanya%20layanan%20jasa%20sales."
        target="_blank"
        rel="noopener"
        class="flex items-center gap-2 bg-[#1C1917] hover:bg-[#C8371B] text-[#FAF8F5] px-3.5 py-2.5 rounded shadow text-xs font-medium transition"
        aria-label="Kontak WhatsApp"
      >
        <span class="w-2 h-2 rounded-full bg-[#E86144]"></span>
        <span>WhatsApp Konsultasi</span>
      </a>
    </aside>

    <!-- Footer -->
    <footer class="bg-[#1C1917] text-[#A8A29E] pt-14 pb-10 border-t border-[#292524] text-xs">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-[#292524]">
          <div class="md:col-span-1">
            <span class="text-sm font-bold text-[#FAF8F5] tracking-tight block mb-2">PT PROSPERA TALENTA</span>
            <p class="leading-relaxed text-[#78716C] mb-4">
              Penyedia dan pengelola jasa sales lapangan, SPG usher, mystery shopper, dan riset pasar B2B terstruktur di Indonesia.
            </p>
            <p class="text-[#78716C]">prosperatalenta.co.id</p>
          </div>

          <div class="md:col-span-2">
            <p class="font-semibold text-[#FAF8F5] uppercase tracking-wider mb-3">Layanan Kami</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <div><a href="/layanan/jasa-direct-sales" class="hover:text-[#FAF8F5] transition">Jasa Direct Sales</a></div>
              <div><a href="/layanan/jasa-kol-visit" class="hover:text-[#FAF8F5] transition">Jasa KOL Visit</a></div>
              <div><a href="/layanan/jasa-riset-pasar" class="hover:text-[#FAF8F5] transition">Jasa Riset Pasar</a></div>
              <div><a href="/layanan/jasa-mystery-shopper" class="hover:text-[#FAF8F5] transition">Jasa Mystery Shopper</a></div>
              <div><a href="/layanan/jasa-spg-usher" class="hover:text-[#FAF8F5] transition">Jasa SPG Usher</a></div>
              <div><a href="/layanan/jasa-sebar-kuesioner" class="hover:text-[#FAF8F5] transition">Jasa Sebar Kuesioner</a></div>
            </div>
          </div>

          <div>
            <p class="font-semibold text-[#FAF8F5] uppercase tracking-wider mb-3">Kantor & Kontak</p>
            <div class="space-y-2 text-[#78716C]">
              <p>Buana Subang Kencana, Blk. D No.29, Karanganyar, Subang, Jawa Barat 41211</p>
              <p><strong class="text-[#A8A29E]">WhatsApp:</strong> 0813-9807-9090</p>
              <p><strong class="text-[#A8A29E]">Email:</strong> jasasalesprospera@gmail.com</p>
            </div>
          </div>
        </div>

        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-[#78716C] gap-3">
          <p>© {new Date().getFullYear()} PT Prospera Talenta. Hak Cipta Dilindungi.</p>
          <div class="flex items-center gap-4">
            <a href="/tentang" class="hover:text-[#A8A29E]">Tentang</a>
            <a href="/layanan" class="hover:text-[#A8A29E]">Layanan</a>
            <a href="/artikel" class="hover:text-[#A8A29E]">Artikel</a>
            <a href="/kontak" class="hover:text-[#A8A29E]">Kontak</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-toggle');
      const menu = document.getElementById('mobile-dropdown');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
