---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('artikel');
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const articleIndexSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Wawasan Sales & Industri B2B - PT Prospera Talenta',
  description: 'Artikel, panduan taktis, dan wawasan industri mengenai outsourcing sales force, SPG event, canvassing, dan strategi penetrasi pasar.',
  url: 'https://prosperaagency.co.id/artikel',
};
---

<Layout
  title="Artikel & Wawasan Sales Force B2B"
  description="Panduan taktis dan analisis industri mengenai manajemen sales lapangan, SPG event, strategi canvassing, dan efisiensi operasional B2B."
  schema={articleIndexSchema}
>
  <section class="bg-[#FAF8F5] border-b border-[#E7E2D9] py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <nav class="text-xs text-[#78716C] mb-3 flex items-center gap-2">
        <a href="/" class="hover:text-[#1C1917]">Beranda</a>
        <span>/</span>
        <span class="text-[#1C1917] font-medium">Artikel</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1C1917] tracking-tight mb-3">
        Wawasan & Publikasi Komersial
      </h1>
      <p class="text-sm sm:text-base text-[#57534E] max-w-2xl leading-relaxed">
        Artikel edukasi, studi kasus lapangan, dan panduan taktis pengelolaan sales force untuk para pemimpin bisnis dan tim komersial.
      </p>
    </div>
  </section>

  <section class="py-14 bg-white border-b border-[#E7E2D9]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <article class="bg-[#FAF8F5] border border-[#E7E2D9] rounded p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-[11px] text-[#78716C] mb-2">
                <span class="font-semibold uppercase tracking-wider text-[#C8371B]">
                  {post.data.category}
                </span>
                <span>{post.data.readingTime}</span>
              </div>
              <h2 class="text-base font-bold text-[#1C1917] mb-2 leading-snug">
                <a href={`/artikel/${post.id}`} class="hover:text-[#C8371B] transition">
                  {post.data.title}
                </a>
              </h2>
              <p class="text-xs text-[#57534E] leading-relaxed mb-4">
                {post.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-[#E7E2D9] flex items-center justify-between text-xs text-[#78716C]">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <a href={`/artikel/${post.id}`} class="font-semibold text-[#1C1917] hover:text-[#C8371B]">
                Baca Selengkapnya &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
