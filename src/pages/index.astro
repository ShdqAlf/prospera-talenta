---
import Layout from '../layouts/Layout.astro';
import { services } from '../data/services';

const featuredServices = services.slice(0, 6);

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'PT Prospera Talenta',
  url: 'https://prosperatalenta.co.id',
};
---

<Layout
  title="Mitra Pengadaan Sales Force & Talenta B2B Skala Nasional"
  description="PT Prospera Talenta mengelola 38.000+ talenta sales lapangan dan digital di 50+ kota Indonesia. Solusi SPG/SPB, canvassing, mystery shopper, dan akuisisi pasar."
  schema={homeSchema}
>
  <!-- Hero Section -->
  <section class="bg-[#FAF8F5] border-b border-[#E7E2D9] pt-16 pb-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold tracking-wider uppercase text-[#C8371B] mb-3">
          Corporate Sales Force Management
        </p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#1C1917] tracking-tight leading-[1.18] mb-5">
          Pengadaan dan Pengelolaan Tim Sales Lapangan untuk Perusahaan Anda.
        </h1>
        <p class="text-base sm:text-lg text-[#57534E] leading-relaxed mb-8">
          PT Prospera Talenta menyediakan infrastruktur tenaga penjualan terkelola di 50+ kota Indonesia. Didukung jaringan 38.000+ talenta terlatih untuk penetrasi pasar modern trade, general trade, event aktivasi, dan ekspansi digital.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20kami%20ingin%20konsultasi%20kebutuhan%20sales%20force%20perusahaan."
            target="_blank"
            rel="noopener"
            class="bg-[#C8371B] hover:bg-[#A82B13] text-[#FAF8F5] font-semibold text-sm px-6 py-3 rounded transition"
          >
            Konsultasi Kebutuhan
          </a>
          <a
            href="/layanan"
            class="bg-white hover:bg-[#F4EFEB] text-[#1C1917] border border-[#E7E2D9] font-medium text-sm px-5 py-3 rounded transition"
          >
            Daftar Layanan
          </a>
        </div>
      </div>

      <!-- Institutional Metrics -->
      <div class="mt-14 pt-8 border-t border-[#E7E2D9] grid grid-cols-2 md:grid-cols-4 gap-6">
        <div>
          <span class="text-3xl font-extrabold text-[#1C1917] block">38.000+</span>
          <span class="text-xs text-[#78716C] uppercase tracking-wider font-medium mt-1 block">Talenta Terdaftar</span>
        </div>
        <div>
          <span class="text-3xl font-extrabold text-[#1C1917] block">50+</span>
          <span class="text-xs text-[#78716C] uppercase tracking-wider font-medium mt-1 block">Kota Cakupan</span>
        </div>
        <div>
          <span class="text-3xl font-extrabold text-[#C8371B] block">24–48 Jam</span>
          <span class="text-xs text-[#78716C] uppercase tracking-wider font-medium mt-1 block">SLA Penugasan</span>
        </div>
        <div>
          <span class="text-3xl font-extrabold text-[#1C1917] block">100%</span>
          <span class="text-xs text-[#78716C] uppercase tracking-wider font-medium mt-1 block">Legal B2B Kontrak</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem & Operational Model -->
  <section class="py-16 bg-white border-b border-[#E7E2D9]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-2xl mb-12">
        <h2 class="text-2xl font-bold text-[#1C1917] tracking-tight mb-3">
          Model Operasional Terstruktur
        </h2>
        <p class="text-sm text-[#57534E] leading-relaxed">
          Kami mengeliminasi friksi rekrutmen internal, fluktuasi turnover tenaga kerja, dan kerumitan supervisi multi-kota.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="border border-[#E7E2D9] rounded p-6 bg-[#FAF8F5]">
          <p class="text-xs font-mono font-bold text-[#C8371B] mb-2">01 / REKRUTMEN</p>
          <h3 class="text-base font-bold text-[#1C1917] mb-2">Database Talenta Siap Kerja</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Seleksi profil sesuai kriteria brand dalam hitungan hari. Tanpa beban administrasi HRD dan payroll jangka panjang.
          </p>
        </div>

        <div class="border border-[#E7E2D9] rounded p-6 bg-[#FAF8F5]">
          <p class="text-xs font-mono font-bold text-[#C8371B] mb-2">02 / KONTROL</p>
          <h3 class="text-base font-bold text-[#1C1917] mb-2">Supervisi Lapangan & GPS</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Koordinator lapangan memvalidasi kehadiran, eksekusi display produk, dan keakuratan interaksi prospek secara harian.
          </p>
        </div>

        <div class="border border-[#E7E2D9] rounded p-6 bg-[#FAF8F5]">
          <p class="text-xs font-mono font-bold text-[#C8371B] mb-2">03 / AKUNTABILITAS</p>
          <h3 class="text-base font-bold text-[#1C1917] mb-2">Laporan Kinerja Terukur</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Rekap kuantitatif sampling, data registrasi, dan transaksi penjualan diserahkan terjadwal untuk audit komersial.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Directory -->
  <section class="py-16 bg-[#FAF8F5] border-b border-[#E7E2D9]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
        <div>
          <h2 class="text-2xl font-bold text-[#1C1917] tracking-tight mb-1">
            Layanan Utama
          </h2>
          <p class="text-xs text-[#78716C]">
            Solusi yang dapat disesuaikan menurut target industri dan skala proyek.
          </p>
        </div>
        <a href="/layanan" class="text-xs font-semibold text-[#C8371B] hover:underline">
          Lihat Semua 10 Layanan &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredServices.map((s) => (
          <div class="bg-white border border-[#E7E2D9] rounded p-6 flex flex-col justify-between">
            <div>
              <p class="text-[11px] font-semibold tracking-wider uppercase text-[#78716C] mb-2">
                {s.categoryLabel}
              </p>
              <h3 class="text-base font-bold text-[#1C1917] mb-2">
                <a href={`/layanan/${s.slug}`} class="hover:text-[#C8371B] transition">
                  {s.title}
                </a>
              </h3>
              <p class="text-xs text-[#57534E] leading-relaxed mb-4">
                {s.tagline}
              </p>
            </div>

            <div class="pt-4 border-t border-[#E7E2D9] flex items-center justify-between text-xs">
              <a href={`/layanan/${s.slug}`} class="font-medium text-[#1C1917] hover:text-[#C8371B]">
                Spesifikasi &rarr;
              </a>
              <a
                href={`https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20kami%20ingin%20tanya%20layanan%20${encodeURIComponent(s.title)}.`}
                target="_blank"
                rel="noopener"
                class="font-semibold text-[#C8371B] hover:text-[#A82B13]"
              >
                Minta Rate Card
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-16 bg-white border-b border-[#E7E2D9]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-[#1C1917] tracking-tight mb-8">
        Tahapan Kerjasama Kemitraan
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="border-l-2 border-[#C8371B] pl-4">
          <span class="text-xs font-mono font-bold text-[#78716C]">LANGKAH 01</span>
          <h3 class="text-sm font-bold text-[#1C1917] mt-1 mb-1">Analisis Kebutuhan</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Penetapan target penjualan, kriteria talenta, alokasi kota, dan durasi proyek.
          </p>
        </div>

        <div class="border-l-2 border-[#C8371B] pl-4">
          <span class="text-xs font-mono font-bold text-[#78716C]">LANGKAH 02</span>
          <h3 class="text-sm font-bold text-[#1C1917] mt-1 mb-1">Kurasi Profil</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Penyajian database kandidat terverifikasi untuk kurasi final oleh tim klien.
          </p>
        </div>

        <div class="border-l-2 border-[#C8371B] pl-4">
          <span class="text-xs font-mono font-bold text-[#78716C]">LANGKAH 03</span>
          <h3 class="text-sm font-bold text-[#1C1917] mt-1 mb-1">Briefing SOP</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Pelatihan produk pengetahuan, etika komunikasi brand, dan simulasi lapangan.
          </p>
        </div>

        <div class="border-l-2 border-[#C8371B] pl-4">
          <span class="text-xs font-mono font-bold text-[#C8371B]">LANGKAH 04</span>
          <h3 class="text-sm font-bold text-[#1C1917] mt-1 mb-1">Penugasan & Laporan</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Deploy tim serentak dengan pengawasan harian dan pelaporan berkala.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-16 bg-[#FAF8F5]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#1C1917] tracking-tight mb-4">
        Konsultasikan Skema Kebutuhan Sales Perusahaan Anda
      </h2>
      <p class="text-sm text-[#57534E] mb-8 max-w-xl mx-auto leading-relaxed">
        Tim representatif PT Prospera Talenta siap menyusun estimasi anggaran dan ketersediaan talenta sesuai target wilayah Anda.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20kami%20ingin%20jadwalkan%20diskusi%20kebutuhan%20sales%20force."
          target="_blank"
          rel="noopener"
          class="bg-[#C8371B] hover:bg-[#A82B13] text-[#FAF8F5] font-semibold text-sm px-6 py-3 rounded transition"
        >
          Hubungi via WhatsApp
        </a>
        <a
          href="/kontak"
          class="bg-white hover:bg-[#F4EFEB] text-[#1C1917] border border-[#E7E2D9] font-medium text-sm px-6 py-3 rounded transition"
        >
          Kirim Formulir RFP
        </a>
      </div>
    </div>
  </section>
</Layout>
