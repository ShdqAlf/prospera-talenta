---
import Layout from '../layouts/Layout.astro';
import { services } from '../data/services';

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'PT Prospera Talenta',
  url: 'https://prosperatalenta.co.id',
};

const homeFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Apa itu jasa sales dari PT Prospera Talenta?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Jasa sales adalah layanan outsourcing pengadaan, pelatihan, dan pengelolaan tim tenaga penjual lapangan profesional (sales force) untuk membantu perusahaan memperluas penetrasi pasar, akuisisi pelanggan, dan peningkatan omzet transaksi.',
      },
    },
    {
      '@type': 'Question',
      name: 'Layanan apa saja yang termasuk dalam jasa sales kami?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Kami menyediakan enam solusi utama: Jasa Direct Sales, Jasa KOL Visit, Jasa Riset Pasar, Jasa Mystery Shopper, Jasa SPG Usher, dan Jasa Sebar Kuesioner.',
      },
    },
    {
      '@type': 'Question',
      name: 'Di kota mana saja layanan jasa sales ini tersedia?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Jasa sales PT Prospera Talenta menjangkau lebih dari 50 kota di seluruh Indonesia, termasuk Jabodetabek, Bandung, Surabaya, Semarang, Medan, Makassar, Denpasar, dan kota-kota sekitarnya.',
      },
    },
    {
      '@type': 'Question',
      name: 'Bagaimana sistem kontrak dan legalitas kerjasama jasa sales?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Seluruh kerjasama dilakukan secara legal B2B di bawah naungan PT Prospera Talenta, lengkap dengan perjanjian kontrak resmi, non-disclosure agreement (NDA), dan faktur pajak perusahaan.',
      },
    },
  ],
};
---

<Layout
  title="Jasa Sales Lapangan & Outsourcing Sales B2B Terpercaya"
  description="Mencari penyedia jasa sales profesional? PT Prospera Talenta menyediakan outsourcing jasa sales lapangan, direct sales, SPG, dan riset pasar di Indonesia."
  schema={homeSchema}
>
  <!-- Hero Section -->
  <section class="bg-[#FAF8F5] border-b border-[#E7E2D9] pt-16 pb-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold tracking-wider uppercase text-[#C8371B] mb-3">
          Penyedia Jasa Sales & Outsourcing B2B Nasional
        </p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#1C1917] tracking-tight leading-[1.18] mb-5">
          Jasa Sales Lapangan Profesional dan Terkelola untuk Pertumbuhan Bisnis Anda.
        </h1>
        <p class="text-base sm:text-lg text-[#57534E] leading-relaxed mb-8">
          Mencari penyedia jasa sales yang siap mendongkrak omzet dan memperluas distribusi produk perusahaan Anda? PT Prospera Talenta hadir sebagai mitra terpercaya penyedia jasa sales lapangan dan outsourcing komersial B2B di lebih dari 50 kota di Indonesia. Kami mengelola tenaga penjualan terlatih agar brand Anda dapat fokus pada inovasi produk dan kepuasan pelanggan.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20kami%20ingin%20konsultasi%20kebutuhan%20jasa%20sales%20perusahaan."
            target="_blank"
            rel="noopener"
            class="bg-[#C8371B] hover:bg-[#A82B13] text-[#FAF8F5] font-semibold text-sm px-6 py-3 rounded transition"
          >
            Konsultasi Kebutuhan Jasa Sales
          </a>
          <a
            href="/layanan"
            class="bg-white hover:bg-[#F4EFEB] text-[#1C1917] border border-[#E7E2D9] font-medium text-sm px-5 py-3 rounded transition"
          >
            Lihat Katalog Layanan
          </a>
        </div>
      </div>

      <!-- Metrics -->
      <div class="mt-14 pt-8 border-t border-[#E7E2D9] grid grid-cols-2 md:grid-cols-4 gap-6">
        <div>
          <span class="text-3xl font-extrabold text-[#1C1917] block">38.000+</span>
          <span class="text-xs text-[#78716C] uppercase tracking-wider font-medium mt-1 block">Talenta Terdaftar</span>
        </div>
        <div>
          <span class="text-3xl font-extrabold text-[#1C1917] block">50+</span>
          <span class="text-xs text-[#78716C] uppercase tracking-wider font-medium mt-1 block">Kota Cakupan</span>
        </div>
        <div>
          <span class="text-3xl font-extrabold text-[#C8371B] block">24–48 Jam</span>
          <span class="text-xs text-[#78716C] uppercase tracking-wider font-medium mt-1 block">SLA Penugasan</span>
        </div>
        <div>
          <span class="text-3xl font-extrabold text-[#1C1917] block">100%</span>
          <span class="text-xs text-[#78716C] uppercase tracking-wider font-medium mt-1 block">Legal B2B Kontrak</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem & Value -->
  <section class="py-16 bg-white border-b border-[#E7E2D9]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-2xl mb-12">
        <h2 class="text-2xl font-bold text-[#1C1917] tracking-tight mb-3">
          Mengapa Bisnis Anda Membutuhkan Jasa Sales Terkelola?
        </h2>
        <p class="text-sm text-[#57534E] leading-relaxed">
          Membangun tim sales internal membutuhkan waktu panjang dan biaya rekrutmen yang tinggi. Selain itu, fluktuasi pergantian karyawan di lapangan sering kali mengganggu pencapaian target. Karena itu, mempercayakan operasional komersial kepada penyedia jasa sales berpengalaman adalah solusi paling efisien.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="border border-[#E7E2D9] rounded p-6 bg-[#FAF8F5]">
          <p class="text-xs font-mono font-bold text-[#C8371B] mb-2">01 / REKRUTMEN CEPAT</p>
          <h3 class="text-base font-bold text-[#1C1917] mb-2">Tanpa Beban HRD Internal</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Dapatkan tenaga penjualan siap kerja dalam hitungan hari. Anda terbebas dari kerumitan administrasi BPJS, pesangon, dan penggajian bulanan.
          </p>
        </div>

        <div class="border border-[#E7E2D9] rounded p-6 bg-[#FAF8F5]">
          <p class="text-xs font-mono font-bold text-[#C8371B] mb-2">02 / KONTROL LAPANGAN</p>
          <h3 class="text-base font-bold text-[#1C1917] mb-2">Supervisi & Pelacakan GPS</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Setiap tim sales didampingi koordinator lapangan untuk memastikan kedisiplinan rute kunjungan, presensi digital, dan kepatuhan SOP brand.
          </p>
        </div>

        <div class="border border-[#E7E2D9] rounded p-6 bg-[#FAF8F5]">
          <p class="text-xs font-mono font-bold text-[#C8371B] mb-2">03 / TARGET TERUKUR</p>
          <h3 class="text-base font-bold text-[#1C1917] mb-2">Akuntabilitas Laporan Harian</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Laporan harian menyajikan data kuantitatif omzet, jumlah interaksi calon pembeli, serta database pelanggan baru yang siap diaudit.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Directory -->
  <section class="py-16 bg-[#FAF8F5] border-b border-[#E7E2D9]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
        <div>
          <h2 class="text-2xl font-bold text-[#1C1917] tracking-tight mb-1">
            Pilihan Solusi Jasa Sales dari PT Prospera Talenta
          </h2>
          <p class="text-xs text-[#78716C]">
            Layanan komprehensif yang dirancang fleksibel sesuai kebutuhan target industri Anda.
          </p>
        </div>
        <a href="/layanan" class="text-xs font-semibold text-[#C8371B] hover:underline">
          Lihat Semua 6 Layanan &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((s) => (
          <div class="bg-white border border-[#E7E2D9] rounded p-6 flex flex-col justify-between">
            <div>
              <p class="text-[11px] font-semibold tracking-wider uppercase text-[#78716C] mb-2">
                {s.categoryLabel}
              </p>
              <h3 class="text-base font-bold text-[#1C1917] mb-2">
                <a href={`/layanan/${s.slug}`} class="hover:text-[#C8371B] transition">
                  {s.title}
                </a>
              </h3>
              <p class="text-xs text-[#57534E] leading-relaxed mb-4">
                {s.tagline}
              </p>
            </div>

            <div class="pt-4 border-t border-[#E7E2D9] flex items-center justify-between text-xs">
              <a href={`/layanan/${s.slug}`} class="font-medium text-[#1C1917] hover:text-[#C8371B]">
                Pelajari Layanan &rarr;
              </a>
              <a
                href={`https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20kami%20ingin%20tanya%20layanan%20${encodeURIComponent(s.title)}.`}
                target="_blank"
                rel="noopener"
                class="font-semibold text-[#C8371B] hover:text-[#A82B13]"
              >
                Minta Penawaran
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-16 bg-white border-b border-[#E7E2D9]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-[#1C1917] tracking-tight mb-3">
        Alur Eksekusi Penugasan Tim Jasa Sales Lapangan
      </h2>
      <p class="text-sm text-[#57534E] mb-8 max-w-2xl leading-relaxed">
        Kami menerapkan standarisasi operasional empat langkah agar penugasan berjalan tertib dan mencapai target yang Anda harapkan.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="border-l-2 border-[#C8371B] pl-4">
          <span class="text-xs font-mono font-bold text-[#78716C]">LANGKAH 01</span>
          <h3 class="text-sm font-bold text-[#1C1917] mt-1 mb-1">Analisis Kebutuhan</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Menetapkan target penjualan produk, spesifikasi kriteria talenta, alokasi kota sasaran, serta jadwal penugasan.
          </p>
        </div>

        <div class="border-l-2 border-[#C8371B] pl-4">
          <span class="text-xs font-mono font-bold text-[#78716C]">LANGKAH 02</span>
          <h3 class="text-sm font-bold text-[#1C1917] mt-1 mb-1">Seleksi Kandidat</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Menyajikan profil kandidat terverifikasi dari basis data kami untuk kurasi persetujuan akhir dari pihak klien.
          </p>
        </div>

        <div class="border-l-2 border-[#C8371B] pl-4">
          <span class="text-xs font-mono font-bold text-[#78716C]">LANGKAH 03</span>
          <h3 class="text-sm font-bold text-[#1C1917] mt-1 mb-1">Pelatihan SOP Produk</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Briefing intensif mengenai product knowledge, etika komunikasi brand, skrip promosi, dan simulasi lapangan.
          </p>
        </div>

        <div class="border-l-2 border-[#C8371B] pl-4">
          <span class="text-xs font-mono font-bold text-[#C8371B]">LANGKAH 04</span>
          <h3 class="text-sm font-bold text-[#1C1917] mt-1 mb-1">Penugasan & Evaluasi</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Pengerahan tim serentak ke lapangan didampingi supervisor dengan pelaporan berkala dan evaluasi berkala.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-[#FAF8F5] border-b border-[#E7E2D9]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-[#1C1917] tracking-tight mb-2 text-center">
        Tanya Jawab Seputar Jasa Sales (FAQ)
      </h2>
      <p class="text-xs sm:text-sm text-[#57534E] text-center mb-10 max-w-xl mx-auto leading-relaxed">
        Pertanyaan yang sering diajukan oleh calon mitra korporat mengenai layanan jasa sales kami.
      </p>

      <div class="space-y-3">
        <div class="p-5 bg-white border border-[#E7E2D9] rounded">
          <h3 class="text-sm font-bold text-[#1C1917] mb-1.5">Apa itu jasa sales dari PT Prospera Talenta?</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Jasa sales adalah layanan outsourcing pengadaan, pelatihan, dan pengelolaan tim tenaga penjual lapangan profesional (sales force) untuk membantu perusahaan memperluas penetrasi pasar, akuisisi pelanggan, dan peningkatan omzet transaksi secara terkelola.
          </p>
        </div>

        <div class="p-5 bg-white border border-[#E7E2D9] rounded">
          <h3 class="text-sm font-bold text-[#1C1917] mb-1.5">Layanan apa saja yang termasuk dalam cakupan jasa sales kami?</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Kami menyediakan enam solusi utama: Jasa Direct Sales, Jasa KOL Visit, Jasa Riset Pasar, Jasa Mystery Shopper, Jasa SPG Usher, dan Jasa Sebar Kuesioner di berbagai kota Indonesia.
          </p>
        </div>

        <div class="p-5 bg-white border border-[#E7E2D9] rounded">
          <h3 class="text-sm font-bold text-[#1C1917] mb-1.5">Di kota mana saja layanan jasa sales ini tersedia?</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Jasa sales PT Prospera Talenta menjangkau lebih dari 50 kota di seluruh Indonesia, termasuk Jabodetabek, Bandung, Surabaya, Semarang, Medan, Makassar, Denpasar, dan kota-kota sekitarnya.
          </p>
        </div>

        <div class="p-5 bg-white border border-[#E7E2D9] rounded">
          <h3 class="text-sm font-bold text-[#1C1917] mb-1.5">Bagaimana sistem kontrak dan legalitas kerjasama jasa sales?</h3>
          <p class="text-xs text-[#57534E] leading-relaxed">
            Seluruh kerjasama dilakukan secara legal B2B di bawah naungan PT Prospera Talenta, lengkap dengan perjanjian kontrak resmi, non-disclosure agreement (NDA), dan faktur pajak perusahaan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#1C1917] tracking-tight mb-4">
        Konsultasikan Kebutuhan Jasa Sales Perusahaan Anda Sekarang
      </h2>
      <p class="text-sm text-[#57534E] mb-8 max-w-xl mx-auto leading-relaxed">
        Representatif PT Prospera Talenta siap menyusun simulasi anggaran, kebutuhan personel, dan jadwal penugasan sesuai target pasar Anda.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20kami%20ingin%20jadwalkan%20diskusi%20kebutuhan%20jasa%20sales."
          target="_blank"
          rel="noopener"
          class="bg-[#C8371B] hover:bg-[#A82B13] text-[#FAF8F5] font-semibold text-sm px-6 py-3 rounded transition"
        >
          Hubungi via WhatsApp
        </a>
        <a
          href="/kontak"
          class="bg-white hover:bg-[#F4EFEB] text-[#1C1917] border border-[#E7E2D9] font-medium text-sm px-6 py-3 rounded transition"
        >
          Kirim Formulir RFP
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(homeFaqSchema)} />
</Layout>
