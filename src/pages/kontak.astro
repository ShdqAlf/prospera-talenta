---
import Layout from '../layouts/Layout.astro';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Kontak PT Prospera Talenta',
  description: 'Saluran resmi komunikasi dan permohonan proposal penugasan sales force PT Prospera Talenta.',
};
---

<Layout
  title="Hubungi Kami - Konsultasi & Permintaan Proposal Jasa Sales B2B"
  description="Hubungi representatif PT Prospera Talenta untuk konsultasi jasa sales, direct sales, SPG usher, KOL visit, mystery shopper, dan riset pasar."
  schema={contactSchema}
>
  <section class="bg-[#FAF8F5] border-b border-[#E7E2D9] py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <nav class="text-xs text-[#78716C] mb-3 flex items-center gap-2">
        <a href="/" class="hover:text-[#1C1917]">Beranda</a>
        <span>/</span>
        <span class="text-[#1C1917] font-medium">Kontak</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1C1917] tracking-tight mb-3">
        Kontak & Permintaan Proposal
      </h1>
      <p class="text-sm sm:text-base text-[#57534E] max-w-2xl leading-relaxed">
        Sampaikan rencana penugasan, spesifikasi talenta, atau jadwal event perusahaan Anda.
      </p>
    </div>
  </section>

  <section class="py-14 bg-white border-b border-[#E7E2D9]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <!-- Kontak Langsung -->
        <div class="space-y-4">
          <div class="p-5 bg-[#FAF8F5] border border-[#E7E2D9] rounded">
            <h3 class="text-sm font-bold text-[#1C1917] mb-1">WhatsApp Business</h3>
            <p class="text-xs text-[#57534E] mb-3">Respon cepat pada hari dan jam kerja operasional.</p>
            <a
              href="https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20kami%20ingin%20konsultasi%20kebutuhan%20sales%20force."
              target="_blank"
              rel="noopener"
              class="text-xs font-semibold text-[#C8371B] hover:underline"
            >
              +62 813-9807-9090 &rarr;
            </a>
          </div>

          <div class="p-5 bg-[#FAF8F5] border border-[#E7E2D9] rounded">
            <h3 class="text-sm font-bold text-[#1C1917] mb-1">Email Kemitraan & RFP</h3>
            <p class="text-xs text-[#57534E] mb-3">Pengiriman dokumen TOR, tender resmi, atau draft NDA.</p>
            <a
              href="mailto:jasasalesprospera@gmail.com"
              class="text-xs font-semibold text-[#1C1917] hover:underline"
            >
              jasasalesprospera@gmail.com &rarr;
            </a>
          </div>

          <div class="p-5 bg-[#FAF8F5] border border-[#E7E2D9] rounded">
            <h3 class="text-sm font-bold text-[#1C1917] mb-1">Alamat Kantor</h3>
            <p class="text-xs text-[#57534E] leading-relaxed">
              Buana Subang Kencana, Blk. D No.29, Karanganyar, Kec. Subang, Kabupaten Subang, Jawa Barat 41211
            </p>
          </div>
        </div>

        <!-- Form RFP -->
        <div class="lg:col-span-2">
          <div class="p-6 sm:p-8 bg-[#FAF8F5] border border-[#E7E2D9] rounded">
            <h2 class="text-lg font-bold text-[#1C1917] mb-1">
              Formulir Permintaan Penawaran (RFP)
            </h2>
            <p class="text-xs text-[#57534E] mb-6">
              Isi parameter dasar kebutuhan Anda di bawah ini untuk diteruskan langsung ke PIC representatif kami.
            </p>

            <form id="rfp-form" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="name" class="block text-xs font-semibold text-[#1C1917] mb-1.5">Nama PIC</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="Nama lengkap Anda"
                    class="w-full px-3.5 py-2 text-xs bg-white border border-[#E7E2D9] rounded focus:outline-none focus:border-[#C8371B]"
                  />
                </div>
                <div>
                  <label for="company" class="block text-xs font-semibold text-[#1C1917] mb-1.5">Perusahaan / Brand</label>
                  <input
                    type="text"
                    id="company"
                    name="company"
                    required
                    placeholder="Nama entitas bisnis"
                    class="w-full px-3.5 py-2 text-xs bg-white border border-[#E7E2D9] rounded focus:outline-none focus:border-[#C8371B]"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="whatsapp" class="block text-xs font-semibold text-[#1C1917] mb-1.5">Nomor WhatsApp</label>
                  <input
                    type="tel"
                    id="whatsapp"
                    name="whatsapp"
                    required
                    placeholder="0812xxxxxxxx"
                    class="w-full px-3.5 py-2 text-xs bg-white border border-[#E7E2D9] rounded focus:outline-none focus:border-[#C8371B]"
                  />
                </div>
                <div>
                  <label for="service" class="block text-xs font-semibold text-[#1C1917] mb-1.5">Kebutuhan Layanan</label>
                  <select
                    id="service"
                    name="service"
                    class="w-full px-3.5 py-2 text-xs bg-white border border-[#E7E2D9] rounded focus:outline-none focus:border-[#C8371B]"
                  >
                    <option value="Jasa Direct Sales">Jasa Direct Sales</option>
                    <option value="Jasa KOL Visit">Jasa KOL Visit</option>
                    <option value="Jasa Riset Pasar">Jasa Riset Pasar</option>
                    <option value="Jasa Mystery Shopper">Jasa Mystery Shopper</option>
                    <option value="Jasa SPG Usher">Jasa SPG Usher</option>
                    <option value="Jasa Sebar Kuesioner">Jasa Sebar Kuesioner</option>
                    <option value="Paket Khusus Multi-Kota">Paket Khusus Multi-Kota</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="city" class="block text-xs font-semibold text-[#1C1917] mb-1.5">Kota Target Penugasan</label>
                <input
                  type="text"
                  id="city"
                  name="city"
                  placeholder="Misal: Jabodetabek, Surabaya, Bandung, atau Nasional"
                  class="w-full px-3.5 py-2 text-xs bg-white border border-[#E7E2D9] rounded focus:outline-none focus:border-[#C8371B]"
                />
              </div>

              <div>
                <label for="notes" class="block text-xs font-semibold text-[#1C1917] mb-1.5">Deskripsi Penugasan / Kuota</label>
                <textarea
                  id="notes"
                  name="notes"
                  rows="3"
                  placeholder="Sampaikan estimasi tanggal mulai, durasi kerja, atau jumlah personel yang dibutuhkan..."
                  class="w-full px-3.5 py-2 text-xs bg-white border border-[#E7E2D9] rounded focus:outline-none focus:border-[#C8371B]"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full bg-[#C8371B] hover:bg-[#A82B13] text-[#FAF8F5] text-xs font-semibold py-3 rounded transition"
              >
                Kirim Permintaan Penawaran ke WhatsApp PIC &rarr;
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('rfp-form') as HTMLFormElement;
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = data.get('name') || '';
        const company = data.get('company') || '';
        const service = data.get('service') || '';
        const city = data.get('city') || '';
        const notes = data.get('notes') || '';

        const text = `Halo PT Prospera Talenta, saya ${name} dari ${company}.

Kami ingin mengajukan permintaan penawaran:
- Layanan: ${service}
- Lokasi: ${city}
- Catatan: ${notes}

Mohon info ketersediaan dan rate card resminya. Terima kasih.`;
        const waUrl = `https://wa.me/6281398079090?text=${encodeURIComponent(text)}`;
        window.open(waUrl, '_blank');
      });
    }
  </script>
</Layout>
