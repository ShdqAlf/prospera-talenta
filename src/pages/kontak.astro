---
import Layout from '../layouts/Layout.astro';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Hubungi Jasa Sales Indonesia',
  description: 'Konsultasi pengadaan tim sales B2B, SPG, direct sales canvassing, dan talent management.',
};
---

<Layout
  title="Hubungi Kami - Konsultasi & Permintaan Proposal B2B"
  description="Hubungi tim representatif Jasa Sales untuk konsultasi kebutuhan sales force perusahaan, rate card, dan proposal kerjasama."
  schema={contactSchema}
>
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <nav class="text-xs text-slate-400 mb-4 flex items-center gap-2">
          <a href="/" class="hover:text-white">Beranda</a>
          <span>/</span>
          <span class="text-white font-medium">Kontak</span>
        </nav>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight mb-4">
          Hubungi Tim Sales Representatif Kami
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          Konsultasikan kebutuhan ekspansi penjualan dan pengadaan talenta perusahaan Anda. Tim kami siap merespon cepat dalam jam kerja.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contact Info Cards -->
        <div class="space-y-6">
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <span class="text-xs uppercase font-bold text-blue-600 tracking-wider">Fast Response</span>
            <h3 class="text-lg font-bold text-slate-900 mt-1 mb-2">WhatsApp Bisnis</h3>
            <p class="text-xs text-slate-500 mb-4">Konsultasi cepat via chat atau panggilan WhatsApp resmi.</p>
            <a
              href="https://wa.me/6281398079090?text=Halo%20JasaSales%2C%20saya%20ingin%20konsultasi%20layanan%20sales%20B2B."
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 font-bold text-emerald-600 hover:text-emerald-700 text-sm"
            >
              +62 813-9807-9090 &rarr;
            </a>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <span class="text-xs uppercase font-bold text-blue-600 tracking-wider">Email Kemitraan</span>
            <h3 class="text-lg font-bold text-slate-900 mt-1 mb-2">Proposal & RFP</h3>
            <p class="text-xs text-slate-500 mb-4">Kirimkan Term of Reference (TOR) atau dokumen tender resmi Anda.</p>
            <a
              href="mailto:jasasalesprospera@gmail.com"
              class="inline-flex items-center gap-2 font-bold text-blue-600 hover:text-blue-700 text-sm"
            >
              jasasalesprospera@gmail.com &rarr;
            </a>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <span class="text-xs uppercase font-bold text-blue-600 tracking-wider">Kantor Operasional</span>
            <h3 class="text-lg font-bold text-slate-900 mt-1 mb-2">Alamat</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Buana Subang Kencana, Blk. D No.29, Karanganyar, Kec. Subang, Kabupaten Subang, Jawa Barat 41211
            </p>
          </div>
        </div>

        <!-- Form Request Proposal -->
        <div class="lg:col-span-2">
          <div class="bg-white p-8 sm:p-10 rounded-2xl border border-slate-200 shadow-sm">
            <h2 class="text-2xl font-extrabold text-slate-900 mb-2">Form Permintaan Penawaran & Proposal</h2>
            <p class="text-sm text-slate-500 mb-8">
              Isi formulir di bawah ini. Tim kami akan menyiapkan estimasi penawaran dan menghubungi Anda melalui WhatsApp.
            </p>

            <form id="lead-form" class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-xs font-bold uppercase text-slate-700 mb-2">Nama Lengkap PIC</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="Contoh: Budi Santoso"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>
                <div>
                  <label for="company" class="block text-xs font-bold uppercase text-slate-700 mb-2">Nama Perusahaan / Brand</label>
                  <input
                    type="text"
                    id="company"
                    name="company"
                    required
                    placeholder="Contoh: PT Sumber Makmur"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="whatsapp" class="block text-xs font-bold uppercase text-slate-700 mb-2">No. WhatsApp Aktif</label>
                  <input
                    type="tel"
                    id="whatsapp"
                    name="whatsapp"
                    required
                    placeholder="081234567890"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>
                <div>
                  <label for="service" class="block text-xs font-bold uppercase text-slate-700 mb-2">Layanan yang Dibutuhkan</label>
                  <select
                    id="service"
                    name="service"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white"
                  >
                    <option value="SPG & SPB Event">Jasa SPG & SPB Event</option>
                    <option value="Direct Sales Canvassing">Jasa Direct Sales & Canvassing</option>
                    <option value="Sales Aplikasi & User Acquisition">Sales Aplikasi & Fintech</option>
                    <option value="Mystery Shopper & Audit">Mystery Shopper & Audit Layanan</option>
                    <option value="Clipper TikTok & Reels">Jasa Clipper Short Video</option>
                    <option value="Buzzer & Micro Influencer">Buzzer & Micro Influencer</option>
                    <option value="Rating & Review Maps/Marketplace">Optimasi Rating & Review</option>
                    <option value="Host Live Streaming">Host Live Streaming</option>
                    <option value="Crew Event Organizer">Crew Event & Usher</option>
                    <option value="Aktivasi Komunitas">Aktivasi Komunitas & Crowd</option>
                    <option value="Kombinasi / Paket Custom">Kombinasi / Paket Custom</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="city" class="block text-xs font-bold uppercase text-slate-700 mb-2">Kota Pelaksanaan Proyek</label>
                <input
                  type="text"
                  id="city"
                  name="city"
                  placeholder="Contoh: Jakarta, Surabaya, Bandung (atau Seluruh Indonesia)"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <div>
                <label for="notes" class="block text-xs font-bold uppercase text-slate-700 mb-2">Deskripsi Ringkas Kebutuhan / Target</label>
                <textarea
                  id="notes"
                  name="notes"
                  rows="4"
                  placeholder="Ceritakan estimasi jumlah personel, tanggal pelaksanaan, atau target yang ingin dicapai..."
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-base py-4 px-6 rounded-xl shadow-lg transition"
              >
                Kirim via WhatsApp Otomatis &rarr;
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('lead-form') as HTMLFormElement;
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = data.get('name') || '';
        const company = data.get('company') || '';
        const service = data.get('service') || '';
        const city = data.get('city') || '';
        const notes = data.get('notes') || '';

        const text = `Halo JasaSales, saya ${name} dari ${company}.\n\nSaya ingin konsultasi kebutuhan layanan:\n- Layanan: ${service}\n- Lokasi: ${city}\n- Catatan: ${notes}\n\nMohon info rate card dan ketersediaan timnya. Terima kasih.`;
        const waUrl = `https://wa.me/6281398079090?text=${encodeURIComponent(text)}`;
        window.open(waUrl, '_blank');
      });
    }
  </script>
</Layout>
