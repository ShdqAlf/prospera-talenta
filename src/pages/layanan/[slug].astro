---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.description,
  provider: {
    '@type': 'Organization',
    name: 'Jasa Sales Indonesia',
    url: 'https://jasasales.com',
  },
  areaServed: {
    '@type': 'Country',
    name: 'Indonesia',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: service.title,
    itemListElement: service.deliverables.map((item) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: item,
      },
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout
  title={`${service.title} - Penyedia Talenta Terlatih`}
  description={`${service.tagline} Database 38.000+ talenta di seluruh Indonesia. Garansi penugasan profesional & supervisi lapangan.`}
  schema={serviceSchema}
>
  <!-- Breadcrumb & Hero -->
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-slate-400 mb-6 flex items-center gap-2">
        <a href="/" class="hover:text-white">Beranda</a>
        <span>/</span>
        <a href="/layanan" class="hover:text-white">Layanan</a>
        <span>/</span>
        <span class="text-blue-400 font-medium">{service.title}</span>
      </nav>

      <div class="max-w-3xl">
        <span class="inline-block text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-md bg-blue-500/20 text-blue-300 border border-blue-400/30 mb-4">
          {service.categoryLabel}
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight mb-6 leading-tight">
          {service.title}
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed mb-8">
          {service.tagline}
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href={`https://wa.me/6281398079090?text=Halo%20JasaSales%2C%20saya%20ingin%20konsultasi%20dan%20minta%20rate%20card%20layanan%20${encodeURIComponent(service.title)}.`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm sm:text-base px-6 py-3.5 rounded-xl shadow-lg transition"
          >
            <span>Dapatkan Penawaran & Rate Card</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Detail Content Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main Info -->
        <div class="lg:col-span-2 space-y-12">
          <div>
            <h2 class="text-2xl font-extrabold text-slate-900 mb-4">Deskripsi Layanan</h2>
            <p class="text-slate-700 leading-relaxed text-base">
              {service.description}
            </p>
          </div>

          <div>
            <h2 class="text-2xl font-extrabold text-slate-900 mb-6">Ruang Lingkup & Deliverables</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {service.deliverables.map((item) => (
                <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
                  <div class="flex items-start gap-3">
                    <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">✓</span>
                    <span class="text-sm font-medium text-slate-800 leading-snug">{item}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div>
            <h2 class="text-2xl font-extrabold text-slate-900 mb-6">Keuntungan Kemitraan B2B</h2>
            <div class="space-y-4">
              {service.benefits.map((benefit, i) => (
                <div class="flex items-start gap-4 p-4 rounded-xl bg-blue-50/50 border border-blue-100">
                  <span class="text-blue-700 font-bold text-sm">{`0${i + 1}`}</span>
                  <p class="text-sm text-slate-700 font-medium">{benefit}</p>
                </div>
              ))}
            </div>
          </div>

          {service.targetIndustries.length > 0 && (
            <div>
              <h2 class="text-xl font-bold text-slate-900 mb-4">Cocok untuk Industri:</h2>
              <div class="flex flex-wrap gap-2">
                {service.targetIndustries.map((ind) => (
                  <span class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 text-xs font-semibold border border-slate-200">
                    {ind}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- FAQs -->
          {service.faqs.length > 0 && (
            <div class="pt-8 border-t border-slate-200">
              <h2 class="text-2xl font-extrabold text-slate-900 mb-6">Pertanyaan yang Sering Diajukan (FAQ)</h2>
              <div class="space-y-4">
                {service.faqs.map((faq) => (
                  <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
                    <h3 class="text-base font-bold text-slate-900 mb-2">{faq.question}</h3>
                    <p class="text-sm text-slate-600 leading-relaxed">{faq.answer}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar Sticky Contact Card -->
        <div class="lg:col-span-1">
          <div class="sticky top-28 bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-sm space-y-6">
            <h3 class="text-lg font-bold text-slate-900 border-b border-slate-200 pb-3">
              Konsultasi Layanan Ini
            </h3>

            <div class="space-y-3 text-sm text-slate-600">
              <div class="flex items-center gap-2 text-xs text-emerald-700 bg-emerald-50 px-3 py-2 rounded-lg font-medium">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                Ketersediaan talenta: Siap deploy
              </div>
              <p class="text-xs text-slate-500">
                Punya spesifikasi khusus atau jumlah kuota personel tertentu? Kami siap siapkan simulasi anggarannya.
              </p>
            </div>

            <div class="space-y-3 pt-2">
              <a
                href={`https://wa.me/6281398079090?text=Halo%20JasaSales%2C%20saya%20mau%20tanya%20detail%20layanan%20${encodeURIComponent(service.title)}.`}
                target="_blank"
                rel="noopener"
                class="w-full block text-center bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm py-3.5 px-4 rounded-xl shadow transition"
              >
                Chat via WhatsApp
              </a>
              <a
                href="/kontak"
                class="w-full block text-center bg-white hover:bg-slate-100 text-slate-800 font-semibold text-sm py-3 px-4 rounded-xl border border-slate-300 transition"
              >
                Minta Form Proposal
              </a>
            </div>

            <div class="pt-4 border-t border-slate-200 text-xs text-slate-500 space-y-2">
              <p>✓ Fast response & konsultasi tanpa komitmen</p>
              <p>✓ SLA seleksi talenta 1-2 hari kerja</p>
              <p>✓ Kontrak kerja resmi B2B berbadan hukum</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- JSON-LD FAQ Schema injection -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
