---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.metaDescription,
  provider: {
    '@type': 'Organization',
    name: 'PT Prospera Talenta',
    url: 'https://prosperatalenta.co.id',
  },
  areaServed: {
    '@type': 'Country',
    name: 'Indonesia',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout
  title={service.metaTitle}
  description={service.metaDescription}
  schema={serviceSchema}
>
  <!-- Breadcrumb & Header -->
  <section class="bg-[#FAF8F5] border-b border-[#E7E2D9] py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <nav class="text-xs text-[#78716C] mb-3 flex items-center gap-2">
        <a href="/" class="hover:text-[#1C1917]">Beranda</a>
        <span>/</span>
        <a href="/layanan" class="hover:text-[#1C1917]">Layanan</a>
        <span>/</span>
        <span class="text-[#1C1917] font-medium">{service.title}</span>
      </nav>

      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-wider text-[#C8371B] mb-2">
          {service.categoryLabel}
        </p>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1C1917] tracking-tight mb-4">
          {service.title}
        </h1>
        <p class="text-base text-[#57534E] leading-relaxed mb-6">
          {service.tagline}
        </p>

        <a
          href={`https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20kami%20ingin%20konsultasi%20layanan%20${encodeURIComponent(service.title)}.`}
          target="_blank"
          rel="noopener"
          class="inline-block bg-[#C8371B] hover:bg-[#A82B13] text-[#FAF8F5] text-xs font-semibold px-5 py-2.5 rounded transition"
        >
          Konsultasi & Minta Rate Card
        </a>
      </div>
    </div>
  </section>

  <!-- Service Details -->
  <section class="py-14 bg-white border-b border-[#E7E2D9]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-12">
          <!-- Overview & Intro -->
          <div>
            <h2 class="text-xl font-bold text-[#1C1917] mb-3 border-b border-[#E7E2D9] pb-2">
              Gambaran Umum {service.title}
            </h2>
            <p class="text-sm text-[#57534E] leading-relaxed mb-4">
              {service.intro}
            </p>
            <p class="text-xs text-[#78716C] leading-relaxed">
              Dikelola langsung oleh manajemen profesional PT Prospera Talenta dengan supervisi lapangan ketat dan pelaporan berkala.
            </p>
          </div>

          <!-- Why Needed -->
          <div>
            <h2 class="text-xl font-bold text-[#1C1917] mb-3 border-b border-[#E7E2D9] pb-2">
              {service.whyTitle}
            </h2>
            <p class="text-sm text-[#57534E] leading-relaxed mb-4">
              {service.whyDescription}
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
              {service.whyPoints.map((point) => (
                <div class="p-3.5 bg-[#FAF8F5] border border-[#E7E2D9] rounded">
                  <h3 class="text-xs font-bold text-[#1C1917] mb-1">{point.title}</h3>
                  <p class="text-xs text-[#57534E] leading-relaxed">{point.desc}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Deliverables -->
          <div>
            <h2 class="text-xl font-bold text-[#1C1917] mb-3 border-b border-[#E7E2D9] pb-2">
              {service.deliverablesTitle}
            </h2>
            <div class="space-y-2.5">
              {service.deliverables.map((item) => (
                <div class="p-3 bg-[#FAF8F5] border border-[#E7E2D9] rounded flex items-start gap-2.5">
                  <span class="text-[#C8371B] font-bold text-sm leading-none mt-0.5">•</span>
                  <span class="text-xs font-medium text-[#1C1917]">{item}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Benefits -->
          <div>
            <h2 class="text-xl font-bold text-[#1C1917] mb-3 border-b border-[#E7E2D9] pb-2">
              {service.benefitsTitle}
            </h2>
            <div class="space-y-2.5">
              {service.benefits.map((b) => (
                <div class="p-3 bg-[#FAF8F5] border-l-3 border-[#C8371B] text-xs text-[#57534E] rounded-r">
                  {b}
                </div>
              ))}
            </div>
          </div>

          <!-- Workflow -->
          <div>
            <h2 class="text-xl font-bold text-[#1C1917] mb-3 border-b border-[#E7E2D9] pb-2">
              {service.workflowTitle}
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              {service.workflow.map((w) => (
                <div class="p-4 bg-[#FAF8F5] border border-[#E7E2D9] rounded">
                  <span class="text-xs font-mono font-bold text-[#C8371B] block mb-1">LANGKAH {w.step}</span>
                  <h3 class="text-xs font-bold text-[#1C1917] mb-1">{w.title}</h3>
                  <p class="text-xs text-[#57534E] leading-relaxed">{w.desc}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Target Industries -->
          {service.targetIndustries.length > 0 && (
            <div>
              <h2 class="text-sm font-bold text-[#1C1917] uppercase tracking-wider mb-2">
                Sektor Industri yang Sesuai:
              </h2>
              <div class="flex flex-wrap gap-2">
                {service.targetIndustries.map((ind) => (
                  <span class="px-3 py-1 bg-[#FAF8F5] text-[#57534E] text-xs border border-[#E7E2D9] rounded">
                    {ind}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- FAQs -->
          {service.faqs.length > 0 && (
            <div class="pt-6 border-t border-[#E7E2D9]">
              <h2 class="text-xl font-bold text-[#1C1917] mb-4">
                Pertanyaan Umum Seputar {service.title}
              </h2>
              <div class="space-y-3">
                {service.faqs.map((faq) => (
                  <div class="p-4 bg-[#FAF8F5] border border-[#E7E2D9] rounded">
                    <h3 class="text-xs font-bold text-[#1C1917] mb-1.5">{faq.question}</h3>
                    <p class="text-xs text-[#57534E] leading-relaxed">{faq.answer}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="sticky top-24 bg-[#FAF8F5] border border-[#E7E2D9] rounded p-5 space-y-4">
            <h3 class="text-sm font-bold text-[#1C1917] pb-2 border-b border-[#E7E2D9]">
              Konsultasi Layanan {service.title}
            </h3>
            <p class="text-xs text-[#57534E] leading-relaxed">
              Hubungi representatif PT Prospera Talenta untuk mendapatkan profil kandidat, rate card resmi, dan proposal penugasan.
            </p>

            <div class="space-y-2 pt-2">
              <a
                href={`https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20kami%20ingin%20konsultasi%20layanan%20${encodeURIComponent(service.title)}.`}
                target="_blank"
                rel="noopener"
                class="block text-center bg-[#C8371B] hover:bg-[#A82B13] text-[#FAF8F5] text-xs font-semibold py-2.5 rounded transition"
              >
                Chat WhatsApp PIC
              </a>
              <a
                href="/kontak"
                class="block text-center bg-white hover:bg-[#FAF8F5] text-[#1C1917] border border-[#E7E2D9] text-xs font-medium py-2 rounded transition"
              >
                Kirim Formulir RFP
              </a>
            </div>

            <div class="pt-3 border-t border-[#E7E2D9] text-[11px] text-[#78716C] space-y-1">
              <p>• Perjanjian kerjasama legal berbadan hukum</p>
              <p>• Skema penagihan corporate B2B invoice</p>
              <p>• Pengawasan langsung supervisor lapangan</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
