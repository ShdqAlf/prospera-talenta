---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.metaDescription,
  provider: {
    '@type': 'Organization',
    name: 'PT Prospera Talenta',
    url: 'https://prosperaagency.co.id',
  },
  areaServed: {
    '@type': 'Country',
    name: 'Indonesia',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Beranda',
      item: 'https://prosperaagency.co.id',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Layanan',
      item: 'https://prosperaagency.co.id/layanan',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: service.title,
      item: `https://prosperaagency.co.id/layanan/${service.slug}`,
    },
  ],
};
---

<Layout
  title={service.metaTitle}
  description={service.metaDescription}
  schema={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <!-- Breadcrumb & Header -->
  <section class="bg-[#FAF8F5] border-b border-[#E7E2D9] py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <nav class="text-xs text-[#78716C] mb-3 flex items-center gap-2">
        <a href="/" class="hover:text-[#1C1917]">Beranda</a>
        <span>/</span>
        <a href="/layanan" class="hover:text-[#1C1917]">Layanan</a>
        <span>/</span>
        <span class="text-[#1C1917] font-medium">{service.title}</span>
      </nav>

      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1C1917] tracking-tight mb-4">
          {service.title}
        </h1>
        <p class="text-base text-[#57534E] leading-relaxed mb-6">
          {service.tagline}
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href={`https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20kami%20ingin%20konsultasi%20layanan%20${encodeURIComponent(service.title)}.`}
            target="_blank"
            rel="noopener"
            class="inline-block bg-[#C8371B] hover:bg-[#A82B13] text-[#FAF8F5] text-xs font-semibold px-5 py-2.5 rounded transition"
          >
            Konsultasi & Minta Rate Card
          </a>
          {service.documentation && service.documentation.length > 0 && (
            <a
              href="#dokumentasi"
              class="inline-flex items-center gap-1.5 bg-white hover:bg-[#F4EFEB] text-[#1C1917] border border-[#E7E2D9] text-xs font-medium px-5 py-2.5 rounded transition shadow-xs"
            >
              <svg class="w-3.5 h-3.5 text-[#78716C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>Lihat Dokumentasi</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Service Details -->
  <section class="py-14 bg-white border-b border-[#E7E2D9]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-12">
          <!-- Overview & Intro -->
          <div>
            <h2 class="text-xl font-bold text-[#1C1917] mb-3 border-b border-[#E7E2D9] pb-2">
              Gambaran Umum {service.title}
            </h2>
            <p class="text-sm text-[#57534E] leading-relaxed mb-4">
              {service.intro}
            </p>
            <p class="text-xs text-[#78716C] leading-relaxed">
              Dikelola langsung oleh manajemen profesional PT Prospera Talenta dengan supervisi lapangan ketat dan pelaporan berkala.
            </p>
          </div>

          <!-- Why Needed -->
          <div>
            <h2 class="text-xl font-bold text-[#1C1917] mb-3 border-b border-[#E7E2D9] pb-2">
              {service.whyTitle}
            </h2>
            <p class="text-sm text-[#57534E] leading-relaxed mb-4">
              {service.whyDescription}
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
              {service.whyPoints.map((point) => (
                <div class="p-3.5 bg-[#FAF8F5] border border-[#E7E2D9] rounded">
                  <h3 class="text-xs font-bold text-[#1C1917] mb-1">{point.title}</h3>
                  <p class="text-xs text-[#57534E] leading-relaxed">{point.desc}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Deliverables -->
          <div>
            <h2 class="text-xl font-bold text-[#1C1917] mb-3 border-b border-[#E7E2D9] pb-2">
              {service.deliverablesTitle}
            </h2>
            <div class="space-y-2.5">
              {service.deliverables.map((item) => (
                <div class="p-3 bg-[#FAF8F5] border border-[#E7E2D9] rounded flex items-start gap-2.5">
                  <span class="text-[#C8371B] font-bold text-sm leading-none mt-0.5">•</span>
                  <span class="text-xs font-medium text-[#1C1917]">{item}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Benefits -->
          <div>
            <h2 class="text-xl font-bold text-[#1C1917] mb-3 border-b border-[#E7E2D9] pb-2">
              {service.benefitsTitle}
            </h2>
            <div class="space-y-2.5">
              {service.benefits.map((b) => (
                <div class="p-3 bg-[#FAF8F5] border-l-3 border-[#C8371B] text-xs text-[#57534E] rounded-r">
                  {b}
                </div>
              ))}
            </div>
          </div>

          <!-- Workflow -->
          <div>
            <h2 class="text-xl font-bold text-[#1C1917] mb-3 border-b border-[#E7E2D9] pb-2">
              {service.workflowTitle}
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              {service.workflow.map((w) => (
                <div class="p-4 bg-[#FAF8F5] border border-[#E7E2D9] rounded">
                  <h3 class="text-xs font-bold text-[#1C1917] mb-1">{w.step}. {w.title}</h3>
                  <p class="text-xs text-[#57534E] leading-relaxed">{w.desc}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Target Industries -->
          {service.targetIndustries.length > 0 && (
            <div>
              <h2 class="text-sm font-bold text-[#1C1917] mb-2">
                Sektor Industri yang Sesuai:
              </h2>
              <p class="text-xs text-[#57534E] leading-relaxed">
                {service.targetIndustries.join(' • ')}
              </p>
            </div>
          )}

          <!-- FAQs -->
          {service.faqs.length > 0 && (
            <div class="pt-6 border-t border-[#E7E2D9]">
              <h2 class="text-xl font-bold text-[#1C1917] mb-4">
                Pertanyaan Umum Seputar {service.title}
              </h2>
              <div class="space-y-3">
                {service.faqs.map((faq) => (
                  <div class="p-4 bg-[#FAF8F5] border border-[#E7E2D9] rounded">
                    <h3 class="text-xs font-bold text-[#1C1917] mb-1.5">{faq.question}</h3>
                    <p class="text-xs text-[#57534E] leading-relaxed">{faq.answer}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="sticky top-24 bg-[#FAF8F5] border border-[#E7E2D9] rounded p-5 space-y-4">
            <h3 class="text-sm font-bold text-[#1C1917] pb-2 border-b border-[#E7E2D9]">
              Konsultasi Layanan {service.title}
            </h3>
            <p class="text-xs text-[#57534E] leading-relaxed">
              Hubungi representatif PT Prospera Talenta untuk mendapatkan profil kandidat, rate card resmi, dan proposal penugasan.
            </p>

            <div class="space-y-2 pt-2">
              <a
                href={`https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20kami%20ingin%20konsultasi%20layanan%20${encodeURIComponent(service.title)}.`}
                target="_blank"
                rel="noopener"
                class="block text-center bg-[#C8371B] hover:bg-[#A82B13] text-[#FAF8F5] text-xs font-semibold py-2.5 rounded transition"
              >
                Chat WhatsApp PIC
              </a>
              <a
                href="/kontak"
                class="block text-center bg-white hover:bg-[#FAF8F5] text-[#1C1917] border border-[#E7E2D9] text-xs font-medium py-2 rounded transition"
              >
                Kirim Formulir RFP
              </a>
            </div>

            <div class="pt-3 border-t border-[#E7E2D9] text-[11px] text-[#78716C] space-y-1">
              <p>• Perjanjian kerjasama legal berbadan hukum</p>
              <p>• Skema penagihan corporate B2B invoice</p>
              <p>• Pengawasan langsung supervisor lapangan</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Dokumentasi Lapangan -->
  {service.documentation && service.documentation.length > 0 && (
    <section id="dokumentasi" class="py-16 bg-[#FAF8F5] border-b border-[#E7E2D9] scroll-mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-[#1C1917] tracking-tight mb-2">
              Dokumentasi Lapangan {service.title}
            </h2>
            <p class="text-sm text-[#57534E] max-w-2xl leading-relaxed">
              Bukti riil eksekusi operasional dan profesionalisme talenta PT Prospera Talenta saat menjalankan penugasan untuk berbagai mitra klien.
            </p>
          </div>
          <span class="text-xs text-[#78716C] font-medium bg-white border border-[#E7E2D9] px-3 py-1.5 rounded self-start sm:self-auto">
            {service.documentation.length} {service.documentation[0].type === 'video' ? 'Video Dokumentasi' : 'Foto Dokumentasi'}
          </span>
        </div>

        {service.documentation[0].type === 'video' ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {service.documentation.map((item) => (
              <div class="bg-white border border-[#E7E2D9] rounded-lg overflow-hidden shadow-xs flex flex-col justify-between">
                <div class="relative bg-black aspect-[9/16] overflow-hidden">
                  <video
                    controls
                    playsinline
                    preload="metadata"
                    class="w-full h-full object-cover"
                  >
                    <source src={item.src} type="video/mp4" />
                    Browser Anda tidak mendukung pemutar video.
                  </video>
                </div>
                <div class="p-4">
                  <h3 class="text-xs font-bold text-[#1C1917] mb-1 leading-snug">
                    {item.title}
                  </h3>
                  {item.caption && (
                    <p class="text-[11px] text-[#78716C] leading-relaxed">
                      {item.caption}
                    </p>
                  )}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            {service.documentation.map((item) => (
              <div class="bg-white border border-[#E7E2D9] rounded-lg overflow-hidden shadow-xs group flex flex-col justify-between">
                <div class="aspect-square bg-[#FAF8F5] overflow-hidden">
                  <img
                    src={item.src}
                    alt={`${item.title} - ${service.title} PT Prospera Talenta`}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                  />
                </div>
                <div class="p-3">
                  <h3 class="text-xs font-bold text-[#1C1917] mb-1 leading-snug">
                    {item.title}
                  </h3>
                  {item.caption && (
                    <p class="text-[11px] text-[#78716C] leading-relaxed">
                      {item.caption}
                    </p>
                  )}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  )}
</Layout>
