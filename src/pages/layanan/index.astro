---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/services';

const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Direktori Layanan PT Prospera Talenta',
  description: 'Pengadaan tim sales lapangan, SPG event, canvassing, mystery shopper, clipper video, dan aktivasi massa B2B.',
  itemListElement: services.map((s, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: s.title,
    url: `https://prosperatalenta.co.id/layanan/${s.slug}`,
  })),
};
---

<Layout
  title="Direktori Layanan Sales Force & Outsourcing Talenta B2B"
  description="Katalog komprehensif layanan PT Prospera Talenta: SPG/SPB event, direct sales canvassing, mystery shopper, sales aplikasi, clipper video, dan aktivasi komunitas."
  schema={catalogSchema}
>
  <section class="bg-[#FAF8F5] border-b border-[#E7E2D9] py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <nav class="text-xs text-[#78716C] mb-3 flex items-center gap-2">
        <a href="/" class="hover:text-[#1C1917]">Beranda</a>
        <span>/</span>
        <span class="text-[#1C1917] font-medium">Layanan</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1C1917] tracking-tight mb-3">
        Direktori Layanan B2B
      </h1>
      <p class="text-sm sm:text-base text-[#57534E] max-w-2xl leading-relaxed">
        Infrastruktur penyedia talenta terlatih dan terorganisir untuk percepatan komersial produk di seluruh wilayah Indonesia.
      </p>
    </div>
  </section>

  <section class="py-14 bg-white border-b border-[#E7E2D9]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <article class="bg-[#FAF8F5] border border-[#E7E2D9] rounded p-6 flex flex-col justify-between">
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-wider text-[#78716C] mb-2">
                {service.categoryLabel}
              </p>
              <h2 class="text-base font-bold text-[#1C1917] mb-2">
                <a href={`/layanan/${service.slug}`} class="hover:text-[#C8371B] transition">
                  {service.title}
                </a>
              </h2>
              <p class="text-xs text-[#57534E] leading-relaxed mb-4">
                {service.description}
              </p>

              <div class="border-t border-[#E7E2D9] pt-3 mb-4">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-[#78716C] mb-2">Cakupan Kerja:</p>
                <ul class="text-xs text-[#57534E] space-y-1">
                  {service.deliverables.slice(0, 3).map((d) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-[#C8371B] font-bold">•</span>
                      <span>{d}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-[#E7E2D9] flex items-center justify-between text-xs">
              <a href={`/layanan/${service.slug}`} class="font-medium text-[#1C1917] hover:text-[#C8371B]">
                Lihat Detail &rarr;
              </a>
              <a
                href={`https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20kami%20ingin%20tanya%20detail%20layanan%20${encodeURIComponent(service.title)}.`}
                target="_blank"
                rel="noopener"
                class="font-semibold text-[#C8371B] hover:text-[#A82B13]"
              >
                Minta Penawaran
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 bg-[#FAF8F5]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-xl font-bold text-[#1C1917] mb-2">
        Kebutuhan Penugasan Skala Multi-Kota?
      </h2>
      <p class="text-xs sm:text-sm text-[#57534E] max-w-xl mx-auto mb-6">
        Kami berpengalaman mengkoordinasikan ratusan personel serentak untuk kampanye peluncuran produk dan roadshow nasional.
      </p>
      <a
        href="https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20kami%20ingin%20konsultasi%20paket%20penugasan%20multi-kota."
        target="_blank"
        rel="noopener"
        class="inline-block bg-[#C8371B] hover:bg-[#A82B13] text-[#FAF8F5] text-xs font-semibold px-5 py-2.5 rounded transition"
      >
        Diskusikan Skema Proyek
      </a>
    </div>
  </section>
</Layout>
