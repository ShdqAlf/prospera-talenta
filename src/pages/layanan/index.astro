---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/services';

const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Direktori Layanan PT Prospera Talenta',
  description: 'Penyedia jasa sales lapangan, jasa direct sales, jasa KOL visit, jasa riset pasar, jasa mystery shopper, jasa SPG usher, dan jasa sebar kuesioner skala nasional.',
  itemListElement: services.map((s, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: s.title,
    url: `https://prosperaagency.co.id/layanan/${s.slug}`,
  })),
};
---

<Layout
  title="Katalog Layanan Jasa Sales & Outsourcing B2B Terlengkap"
  description="Daftar lengkap layanan PT Prospera Talenta: Jasa Direct Sales, Jasa KOL Visit, Jasa Riset Pasar, Jasa Mystery Shopper, Jasa SPG Usher, dan Jasa Sebar Kuesioner."
  schema={catalogSchema}
>
  <section class="bg-[#FAF8F5] border-b border-[#E7E2D9] py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <nav class="text-xs text-[#78716C] mb-3 flex items-center gap-2">
        <a href="/" class="hover:text-[#1C1917]">Beranda</a>
        <span>/</span>
        <span class="text-[#1C1917] font-medium">Layanan</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1C1917] tracking-tight mb-3">
        Katalog Layanan Jasa Sales & Talenta Lapangan B2B
      </h1>
      <p class="text-sm sm:text-base text-[#57534E] max-w-2xl leading-relaxed mb-6">
        Infrastruktur penyedia talenta terlatih dan terkelola untuk percepatan distribusi, validasi pasar, serta promosi produk bisnis Anda di seluruh wilayah Indonesia.
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href="https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20kami%20ingin%20konsultasi%20katalog%20layanan."
          target="_blank"
          rel="noopener"
          class="bg-[#C8371B] hover:bg-[#A82B13] text-[#FAF8F5] text-xs font-semibold px-5 py-2.5 rounded transition"
        >
          Konsultasi Kebutuhan Layanan
        </a>
        <a
          href="/#dokumentasi"
          class="bg-white hover:bg-[#F4EFEB] text-[#1C1917] border border-[#E7E2D9] text-xs font-medium px-5 py-2.5 rounded transition inline-flex items-center gap-1.5 shadow-xs"
        >
          <svg class="w-3.5 h-3.5 text-[#78716C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Lihat Dokumentasi Lapangan</span>
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 bg-white border-b border-[#E7E2D9]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <article class="bg-[#FAF8F5] border border-[#E7E2D9] rounded p-6 flex flex-col justify-between">
            <div>
              <h2 class="text-base font-bold text-[#1C1917] mb-2">
                <a href={`/layanan/${service.slug}`} class="hover:text-[#C8371B] transition">
                  {service.title}
                </a>
              </h2>
              <p class="text-xs text-[#57534E] leading-relaxed mb-4">
                {service.description}
              </p>

              <div class="border-t border-[#E7E2D9] pt-3 mb-4">
                <p class="text-xs font-semibold text-[#1C1917] mb-2">Cakupan Tugas:</p>
                <ul class="text-xs text-[#57534E] space-y-1">
                  {service.deliverables.slice(0, 3).map((d) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-[#C8371B] font-bold">•</span>
                      <span>{d}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-[#E7E2D9] flex flex-wrap items-center justify-between gap-2 text-xs">
              <a href={`/layanan/${service.slug}`} class="font-medium text-[#1C1917] hover:text-[#C8371B]">
                Lihat Detail Layanan &rarr;
              </a>
              <a
                href={`/layanan/${service.slug}#dokumentasi`}
                class="text-[#78716C] hover:text-[#C8371B] underline"
              >
                Dokumentasi
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 bg-[#FAF8F5]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-xl font-bold text-[#1C1917] mb-2">
        Kebutuhan Penugasan Skala Multi-Kota?
      </h2>
      <p class="text-xs sm:text-sm text-[#57534E] max-w-xl mx-auto mb-6">
        Kami berpengalaman mengkoordinasikan ratusan personel serentak untuk kampanye peluncuran produk dan aktivasi komersial nasional.
      </p>
      <a
        href="https://wa.me/6281398079090?text=Halo%20PT%20Prospera%20Talenta%2C%20kami%20ingin%20konsultasi%20paket%20penugasan%20multi-kota."
        target="_blank"
        rel="noopener"
        class="inline-block bg-[#C8371B] hover:bg-[#A82B13] text-[#FAF8F5] text-xs font-semibold px-5 py-2.5 rounded transition"
      >
        Diskusikan Skema Proyek
      </a>
    </div>
  </section>
</Layout>
